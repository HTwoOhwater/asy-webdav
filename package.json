{
  "name": "asy-webdav",
  "version": "0.2.0",
  "private": true,
  "description": "AnyShare(山大云盘) HTTP API -> WebDAV 网关：把 asy-cli 的云盘 API 直接包装成 WebDAV，供 Zotero / Obsidian 使用，无需官方客户端与本地同步盘",
  "main": "server.js",
  "bin": {
    "asy-webdav": "cli.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HTwoOhwater/asy-webdav.git"
  },
  "keywords": [
    "webdav",
    "anyshare",
    "zotero",
    "obsidian",
    "icloud",
    "sdu",
    "webdav-server"
  ],
  "files": [
    "cli.js",
    "server.js",
    "start.bat",
    "lib/",
    "scripts/",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/contract.test.js test/cli.test.js test/config.test.js test/resilience.test.js test/cache.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "anyshare-university-cli": "git+https://github.com/HTwoOhwater/anyshare-university-cli.git#6ab6888",
    "webdav-server": "^2.6.3"
  }
}
